{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "react/jsx-no-target-blank": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "node_modules",
    "public"
  ]
}
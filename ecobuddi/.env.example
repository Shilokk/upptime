# Anthropic API key used ONLY by the Express server in /server.
# The browser never sees this value. Leave it unset to run in demo mode.
ANTHROPIC_API_KEY=

# Optional: port for the Express API server (Vite proxies /api to it).
PORT=8787

# Optional: use a different Claude model (default claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-5
